{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"]
    /* No `paths` mapping on purpose. The showcase imports through the package
       name, and TypeScript resolves that through this package's own `exports`
       map via self-reference — the same mechanism Vite uses at runtime. An
       alias here would bypass the exports map and hide a missing subpath
       until it broke in someone else's project. */
  },
  "include": ["components", "layout", "motion", "showcase/src"],
  "exclude": ["node_modules", "dist-showcase"]
}
